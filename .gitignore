# Ambiente virtual. O oficial fica FORA do projeto, no disco Linux (em /mnt/c os imports são ~5x mais lentos):
#   python3 -m venv ~/.venvs/llm-local && ~/.venvs/llm-local/bin/pip install -r requirements.txt
.venv/

# Bytecode gerado pelo interpretador
__pycache__/
*.pyc

# Quarentena do delete_file (arquivos "apagados" pelo agente)
.trash/

# Logs e capturas de terminal
logs/
*.log
(.venv)*.txt

# Pastas de teste do agente (conteúdo descartável)
teste_dir/
teste_sandbox/

# Configuração local do editor
.vscode/
